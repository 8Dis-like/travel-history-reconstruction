# Frontend (React)
frontend/node_modules/
frontend/dist/
frontend/build/
**/.env
**/.env.local
**/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.eslintcache
**/coverage/

# Backend (Python/FastAPI)
backend/.venv/
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/
**/.coverage

# Editor / OS
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Data (large files — use Git LFS or DVC)
data/raw/*
data/processed/*
data/synthetic_dataset/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Rotation robustness test set — large image binaries are ignored;
# the labels_source.csv / labels.csv (the actual label assets) are tracked.
data/rotation_testset/_candidates/
data/rotation_testset/_candidates_preview/
data/rotation_testset/images/

# Synthetic scene test set — composited page images are ignored;
# metadata.json + yolo_detect labels (the ground-truth assets) are tracked.
data/synthetic_scenes/images/

# Model weights (large files)
models/pretrained/*
models/finetuned/*
*.pt
*.onnx
!models/pretrained/.gitkeep
!models/finetuned/.gitkeep

# OS
.DS_Store
Thumbs.db
